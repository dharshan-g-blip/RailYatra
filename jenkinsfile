pipeline {
    agent any
    stages {
        stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/dharshan-g-blip/RailYatra.git'
            }
        }
        stage('Build Docker Image') {
            steps {
                bat 'docker build -t railyatra .'
            }
        }
        stage('Run Container') {
            steps {
                bat 'docker stop railyatra || exit 0'
                bat 'docker rm railyatra || exit 0'
                bat 'docker run -d -p 8081:80 --name railyatra railyatra'
            }
        }
    }
}
