pipeline {
    agent any

    stages {
        stage('Build and Test with Maven') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Check Docker') {
            steps {
                bat 'docker --version'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t railyatra-app:latest .'
            }
        }

        stage('Check Kubernetes') {
            steps {
                bat 'kubectl version --client'
                bat 'kubectl config current-context'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f k8s/deployment.yaml'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl rollout status deployment/railyatra --timeout=120s'
                bat 'kubectl get deployments'
                bat 'kubectl get pods'
                bat 'kubectl get services'
            }
        }
    }

    post {
        success {
            echo 'RailYatra built and deployed to Kubernetes successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Console Output for the first error.'
        }
    }
}